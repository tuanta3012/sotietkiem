<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Chặn triệt để sao lưu đám mây Google One (Android 12+) -->
    <cloud-backup>
        <exclude path="." />
    </cloud-backup>
    <!-- Chặn truyền dữ liệu khi chuyển thiết bị -->
    <device-transfer>
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
